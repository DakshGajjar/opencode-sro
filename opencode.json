{
  "$schema": "https://opencode.ai/config.json",
  "version": 1,
  "instructions": [
    ".opencode/instructions/SRO.md",
    ".opencode/instructions/SCOPE.md",
    ".opencode/instructions/EVIDENCE.md",
    ".opencode/instructions/SAFETY.md",
    ".opencode/instructions/METHOD.md",
    ".opencode/instructions/PROVIDERS.md"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "lfm2.5": {
          "name": "LFM 2.5 (fast local)"
        },
        "qwen3:14b": {
          "name": "Qwen3 14B (local reasoning)"
        },
        "spark-x2.5": {
          "name": "Spark X2.5 (security local)"
        }
      }
    }
  },
  "mcp": {
    "sro_readers": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "sro.connectors.mcp.server"
      ],
      "environment": {
        "SRO_ROOT": "${PWD}"
      },
      "enabled": false
    }
  }
}
