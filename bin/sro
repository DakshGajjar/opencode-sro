#!/usr/bin/env bash
# SRO command line entry point.
#
# Runs the deterministic Python core from a checkout without an install step, so
# the control plane is usable on a research laptop with nothing but Python 3.11+.
set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -n "${SRO_PYTHON:-}" ]; then
  python_bin="$SRO_PYTHON"
elif [ -x "$here/.venv/bin/python" ]; then
  python_bin="$here/.venv/bin/python"
else
  python_bin="$(command -v python3 || command -v python)"
fi

if [ -z "$python_bin" ]; then
  echo "sro: no python interpreter found (set SRO_PYTHON)" >&2
  exit 4
fi

version="$("$python_bin" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo 0.0)"
case "$version" in
  3.1[1-9]|3.[2-9][0-9]|[4-9].*) ;;
  *)
    echo "sro: python 3.11+ is required, found $version" >&2
    exit 4
    ;;
esac

export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
exec "$python_bin" -m sro.cli.main --root "${SRO_ROOT:-$here}" "$@"
